root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cc, cpp, h}]
indent_size = 4
indent_style = space

[*.{json,jsonc,yaml,yml,toml,xml,mjs,js,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
